PORT=4000
# Long random string. Used to open /admin and call admin APIs.
ADMIN_TOKEN=change-me-to-a-long-random-string
# Your website address (CORS). Use * only while testing.
ALLOWED_ORIGIN=http://localhost:3000
# Optional: email alert for every new booking (https://resend.com)
RESEND_API_KEY=
NOTIFY_EMAIL=you@yourdomain.com
FROM_EMAIL=Halston Estates <bookings@yourdomain.com>
